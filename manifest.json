{
  "manifest_version": 3,
  "name": "上岸莫卷",
  "version": "2.7.0",
  "description": "把粉笔答题界面变成「上岸莫卷」：纸 / 墨双主题、限宽阅读版心、可换阅读字体与清晰选项状态；只改外观，不干扰答题与判分。",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "tabs"],
  "host_permissions": [
    "*://*.fenbi.com/*",
    "https://github.com/MrLaughing/shangan-mojuan/*",
    "https://raw.githubusercontent.com/MrLaughing/shangan-mojuan/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://spa.fenbi.com/ti/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "上岸莫卷 · 粉笔答题界面",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
